# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Models (verified available in Phase 0 via the Models API)
MODEL_FAST=claude-haiku-5-5
MODEL_ADVOCATE=claude-sonnet-5-5
MODEL_JUDGE=claude-opus-5-5
# Local embedding model (fastembed / ONNX, downloaded into data/index/models)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Paths (relative to project root)
DATA_DIR=data
PACKS_DIR=data/runemark
INDEX_DIR=data/index
PROCESSED_DIR=data/processed
LOG_DIR=logs
DB_PATH=logs/ragnarok.db

# Limits (hard caps enforced in code)
MAX_RUNS=3
MAX_CROSS_EXAM_ROUNDS=1
MAX_TOOL_CALLS_PER_AGENT=12
MAX_TOOL_CALLS_PER_CASE=60
MAX_TOKENS_PER_AGENT=150000
MAX_TOKENS_PER_CASE=600000
LLM_MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_S=120
MAX_RETRIES=2
MAX_UPLOAD_BYTES=20971520
MAX_EVIDENCE_PER_QUERY=12
MAX_EVIDENCE_PER_CASE=200
