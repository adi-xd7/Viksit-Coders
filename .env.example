# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_actual_anthropic_api_key_here

# Google Gemini API Key (Backup / Primary Provider)
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Active Provider: "anthropic" (default with Gemini backup), or "gemini" (direct Gemini)
LLM_PROVIDER=gemini

# Model Selection
MODEL_FAST=claude-3-haiku-20240307
MODEL_ADVOCATE=claude-3-5-sonnet-20241022
MODEL_JUDGE=claude-3-5-sonnet-20241022

# Execution Budgets & Limits
MAX_RUNS=3
MAX_ROUNDS=2
MAX_RETRIES=2
MAX_TOOL_CALLS_PER_AGENT=12
MAX_TOKENS_PER_CASE=200000
LLM_TIMEOUT=60.0

# Audit Logging Paths
LOGBOOK_DB_PATH=logs/audit.db
LOGBOOK_JSONL_PATH=logs/audit.jsonl
