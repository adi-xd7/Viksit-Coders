# Copy to .env and fill in. Never commit .env.

# LLM provider: gemini (Google AI Studio) or anthropic. Only the key for the selected provider is needed.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini models (structured output verified on gemini-3.5-flash for every trial schema)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_ADVOCATE=gemini-3.5-flash
GEMINI_MODEL_JUDGE=gemini-3.5-flash
# Pacing for rate-limited keys: seconds between request starts (free tier ~5/min -> 13), and
# bounded retries for 429/503 (the server's retryDelay is honoured, capped at the max wait)
LLM_MIN_INTERVAL_S=13
LLM_RATE_LIMIT_RETRIES=6
LLM_RATE_LIMIT_MAX_WAIT_S=90
GEMINI_REQUEST_TIMEOUT_S=120

# Anthropic models (used when LLM_PROVIDER=anthropic)
MODEL_FAST=claude-haiku-5-5
MODEL_ADVOCATE=claude-sonnet-5-5
MODEL_JUDGE=claude-opus-5-5
# Local embedding model (fastembed / ONNX, downloaded into data/index/models)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Paths (relative to project root)
DATA_DIR=data
PACKS_DIR=data/runemark
INDEX_DIR=data/index
PROCESSED_DIR=data/processed
LOG_DIR=logs
DB_PATH=logs/ragnarok.db

# Limits (hard caps enforced in code)
MAX_RUNS=2
MAX_CROSS_EXAM_ROUNDS=1
MAX_TOOL_CALLS_PER_AGENT=45
MAX_TOOL_CALLS_PER_CASE=180
MAX_TOKENS_PER_AGENT=450000
MAX_TOKENS_PER_CASE=1500000
LLM_MAX_OUTPUT_TOKENS=16000
REQUEST_TIMEOUT_S=300
MAX_RETRIES=2
MAX_UPLOAD_BYTES=20971520
MAX_EVIDENCE_PER_QUERY=12
MAX_EVIDENCE_PER_CASE=400

# Retrieval (Reciprocal Rank Fusion constant)
RRF_K=60

# Trial
LLM_REFUSAL_FALLBACK=true
# Planning turns per agent per step (one extra turn only while an agent's required own search is missing)
MAX_RESEARCH_ROUNDS=1
# Tool requests one planning turn may make
MAX_REQUESTS_PER_ROUND=8
MAX_CLAIMS_PER_ADVOCATE=8
MAX_ATTACKS_PER_ADVOCATE=3
EFFORT_ADVOCATE=medium
EFFORT_JUDGE=high
MAX_SENDBACK_QUERIES_PER_ITEM=2

# LLM request economy (a full two-run case needs about 22 model requests with these defaults;
# the false/legacy values restore the older paths, about 40-55 requests)
# Hard cap on model requests per case (LIMIT_HIT, then a graceful finish); replays from the case cache do not count
MAX_LLM_CALLS_PER_CASE=30
# Code-run searches derived from the question (0 = off); shared with Thor and Loki through the query cache
HEIMDALL_SEED_SEARCHES=4
SHARE_SEEDS_WITH_ADVOCATES=true
# Cross-examination searches derived in code (no planning call); defense re-reads this many cited documents per attack
CROSS_EXAM_CODE_SEARCH=true
CROSS_EXAM_READS_PER_ATTACK=1
# Odin: rulings + assessment in one call (two-step fallback); planning turn off (citations/calcs checked in code)
ODIN_MERGED_CALL=true
ODIN_RESEARCH_ROUND=false
# Run 2+: only revised/new claims are cross-examined and re-ruled; earlier rulings of unchanged claims stand
DELTA_RUN=true
# Send-back follow-up planning turn (false: code fetches the trade tables the targeted searches hit)
SENDBACK_FOLLOWUP_LLM=false
# residual_first: repair only schema failures and parts code cannot drop; always: repair every problem
REPAIR_MODE=residual_first
# Same-case reply cache: re-running a failed case ID (CLI --resume / POST /cases/{id}/resume) replays finished steps
LLM_RESPONSE_CACHE=true

# Private agent memory
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=5
MEMORY_BASELINE=true
# combined: one call returns the no-memory plan and the memory plan; separate: an extra baseline call
MEMORY_BASELINE_MODE=combined
CASES_DIR=logs/cases

# API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_CONCURRENT_CASES=1
MAX_UPLOAD_FILES=2000
